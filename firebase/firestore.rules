rules_version = '2';

// 설계: docs/run/data-model-erd.md 4장, 규칙 원칙: firebase/CLAUDE.md
// - 본인만 users/{uid} 아래 정해진 경로(프로필 문서 · runs · goals)에 접근한다.
// - 모든 쓰기는 serverUpdatedAt == request.time (Pull 커서 전제).
// - 허용 필드 목록(hasOnly)으로 원시 GPS 점 같은 큰 필드를 막는다.
// - get() · exists()를 쓰지 않는다 (읽기로 집계됨).
// - Firestore 필드는 추가만 한다. 새 필드는 hasOnly 목록에만 넣고 필수 목록(hasAll)에는
//   넣지 않는다. 옛 버전 앱이 쓴 문서도 계속 통과해야 하기 때문이다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isServerTime(d) {
      return d.serverUpdatedAt == request.time;
    }

    // 복원 · 탈퇴는 50개씩 페이지로 읽는다. limit이 없으면 null 비교가 실패해 거부된다.
    function isPagedQuery() {
      return request.query.limit <= 50;
    }

    function isMillis(v) {
      return v is int && v >= 0;
    }

    function isMillisOrNull(v) {
      return v == null || isMillis(v);
    }

    function isShortString(v, max) {
      return v is string && v.size() <= max;
    }

    function isShortStringOrNull(v, max) {
      return v == null || isShortString(v, max);
    }

    // 키가 없으면 통과 (프로필 문서는 일부 필드만 쓸 수 있다)
    function optional(d, key, ok) {
      return !(key in d) || ok;
    }

    // users/{uid}
    function isValidProfile(d) {
      return d.keys().hasAll(['updatedAt', 'serverUpdatedAt'])
        && d.keys().hasOnly([
          'termsVersion', 'privacyVersion', 'locationTermsVersion',
          'ageOver14', 'marketing', 'agreedAt', 'marketingUpdatedAt',
          'weightKg', 'distanceUnit', 'profileUpdatedAt',
          'updatedAt', 'serverUpdatedAt'
        ])
        && optional(d, 'termsVersion', isShortString(d.get('termsVersion', ''), 32))
        && optional(d, 'privacyVersion', isShortString(d.get('privacyVersion', ''), 32))
        && optional(d, 'locationTermsVersion', isShortString(d.get('locationTermsVersion', ''), 32))
        && optional(d, 'ageOver14', d.get('ageOver14', false) is bool)
        && optional(d, 'marketing', d.get('marketing', false) is bool)
        && optional(d, 'agreedAt', isMillis(d.get('agreedAt', 0)))
        && optional(d, 'marketingUpdatedAt', isMillisOrNull(d.get('marketingUpdatedAt', null)))
        && optional(d, 'weightKg', d.get('weightKg', null) == null || d.get('weightKg', 0) is number)
        && optional(d, 'distanceUnit', d.get('distanceUnit', '') in ['KM', 'MILE'])
        && optional(d, 'profileUpdatedAt', isMillisOrNull(d.get('profileUpdatedAt', null)))
        && isMillis(d.updatedAt)
        && isServerTime(d);
    }

    // users/{uid}/runs/{runId}
    function isValidRun(d, runId) {
      return d.keys().hasAll([
          'id', 'schemaVersion', 'status', 'startedAt', 'endedAt', 'zoneId',
          'distanceM', 'movingMs', 'elapsedMs', 'calories', 'splits',
          'routePolyline', 'routeSegments', 'title', 'memo',
          'source', 'activityType', 'planId',
          'createdAt', 'updatedAt', 'deletedAt', 'serverUpdatedAt'
        ])
        && d.keys().hasOnly([
          'id', 'schemaVersion', 'status', 'startedAt', 'endedAt', 'zoneId',
          'distanceM', 'movingMs', 'elapsedMs', 'calories', 'splits',
          'routePolyline', 'routeSegments', 'title', 'memo',
          'source', 'activityType', 'planId',
          'createdAt', 'updatedAt', 'deletedAt', 'serverUpdatedAt'
        ])
        && d.id == runId
        && d.schemaVersion is int && d.schemaVersion >= 1
        // 서버에는 끝난 기록만 올린다 (진행 중 · 버린 기록 제외)
        && d.status == 'FINISHED'
        && isMillis(d.startedAt)
        && isMillis(d.endedAt)
        && isShortString(d.zoneId, 64)
        && d.distanceM is number && d.distanceM >= 0
        && isMillis(d.movingMs)
        && isMillis(d.elapsedMs)
        && (d.calories == null || (d.calories is int && d.calories >= 0))
        && d.splits is list && d.splits.size() <= 200
        && isShortStringOrNull(d.routePolyline, 20000)
        && d.routeSegments is list && d.routeSegments.size() <= 200
        && isShortStringOrNull(d.title, 40)
        && isShortStringOrNull(d.memo, 500)
        && isShortString(d.source, 32)
        && isShortString(d.activityType, 32)
        && isShortStringOrNull(d.planId, 64)
        && isMillis(d.createdAt)
        && isMillis(d.updatedAt)
        && isMillisOrNull(d.deletedAt)
        && isServerTime(d);
    }

    // users/{uid}/goals/{goalId}
    function isValidGoal(d, goalId) {
      return d.keys().hasAll([
          'id', 'type', 'value', 'effectiveWeekStart',
          'createdAt', 'updatedAt', 'deletedAt', 'serverUpdatedAt'
        ])
        && d.keys().hasOnly([
          'id', 'type', 'value', 'effectiveWeekStart',
          'createdAt', 'updatedAt', 'deletedAt', 'serverUpdatedAt'
        ])
        && d.id == goalId
        && d.type in ['DISTANCE', 'COUNT']
        && d.value is number && d.value > 0
        && d.effectiveWeekStart is string
        && d.effectiveWeekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isMillis(d.createdAt)
        && isMillis(d.updatedAt)
        && isMillisOrNull(d.deletedAt)
        && isServerTime(d);
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProfile(request.resource.data);
      // 실제 삭제는 회원 탈퇴에서만 호출한다
      allow delete: if isOwner(uid);

      match /runs/{runId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid) && isPagedQuery();
        allow create, update: if isOwner(uid) && isValidRun(request.resource.data, runId);
        // 일반 삭제는 deletedAt(soft delete). 실제 삭제는 회원 탈퇴에서만 호출한다
        allow delete: if isOwner(uid);
      }

      match /goals/{goalId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid) && isPagedQuery();
        allow create, update: if isOwner(uid) && isValidGoal(request.resource.data, goalId);
        allow delete: if isOwner(uid);
      }
    }
  }
}
