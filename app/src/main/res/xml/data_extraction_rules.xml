<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 백업 규칙.
  - 클라우드 백업(사용자의 Google Drive): 설정(DataStore)만 올린다.
    기록 DB(pacenote.db)에는 원시 GPS 점(run_point)이 있어 기기 밖으로 보내지 않는다 (CLAUDE.md).
  - 기기 간 이전(케이블 · 근거리 직접 전송): 서버를 거치지 않으므로 기록 DB까지 옮긴다.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
